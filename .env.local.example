# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# Required: your CALL-E Developer API key (from https://dashboard.heycall-e.com/account/api-keys)
CALLE_API_KEY=

# Required: an authorized test phone number in E.164 format, e.g. +59400000000
# Must be a number you own or whose owner explicitly consented to a test call.
TEST_PHONE_NUMBER=

# Optional: override the CALL-E API base URL (defaults to the SDK default)
# CALLE_BASE_URL=https://api.heycall-e.com

# Optional: recipient locale hint for the call (default: fr-FR)
# TEST_LOCALE=fr-FR

# --- Phase 2: river-crossing verification demo ---
# Selects the provider. Defaults to "demo" when unset - safe by default,
# no real call can happen unless this is explicitly set to "live".
# CALLE_MODE=demo

# Source A / Source B authorized phone numbers + locales.
# Only read when CALLE_MODE=live. Must be numbers you own or that the
# owner explicitly consented to being called for this test.
# SOURCE_A_PHONE_NUMBER=
# SOURCE_A_LOCALE=
# SOURCE_B_PHONE_NUMBER=
# SOURCE_B_LOCALE=

# Optional: local demo server port (default 8787)
# PORT=8787
